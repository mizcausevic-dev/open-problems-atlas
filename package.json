{
  "name": "open-problems-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A local-first atlas of every open problem on Wikipedia's List of unsolved problems in mathematics, with a private research journal and an interactive math lab.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data": "node scripts/build-dataset.mjs",
    "data:verify": "node scripts/verify-dataset.mjs"
  },
  "dependencies": {
    "katex": "^0.16.11",
    "lucide-react": "^0.460.0",
    "motion": "^11.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
